mean_ecv_estimate <- mean(blast_data_player$early_con_var)
sd_ecv_estimate <- sd(blast_data_player$early_con_var)
high_bat_speed <- avg_bat_speed + 0.75*sd_bat_speed # 64.01
low_bat_speed <- avg_bat_speed - 0.75*sd_bat_speed # 57.76
# create randomly generated bat speeds, assign them to Twins players
random_ecv <- rnorm(17, mean = 8, sd = 0.5*sd_ecv_estimate)
random_ec_angle <- rnorm(17, mean = 90, sd = 0.25*sd(blast_data_filtered$Early.Connection..deg.))
NST_hitterdata <- NST_hitterdata %>% mutate(rng_ec_angle = random_ec_angle, rng_ecv = random_ecv)
NST_hitterdata <- NST_hitterdata %>% mutate(bucket = case_when(
wOBA > high_wOBA ~ "challenge",
rng_ec_angle >= 95 | rng_ec_angle <= 85 | rng_ecv > 9 ~ "launch pos",
rng_bat_speed < low_bat_speed & K_pct < low_K_pct & GB. > high_GB_pct ~ "bat speed",
GB. > high_GB_pct | FB. > high_FB_pct ~ "swing decision",
rng_bat_speed < low_bat_speed & K_pct > high_K_pct ~ "confidence",
TRUE ~ "undefined"
))
NST_hitterdata_small <- NST_hitterdata %>% select(Last, First, LD., FB., GB., K_pct, wOBA, rng_bat_speed, rng_ec_angle, rng_ecv, bucket)
view(NST_hitterdata_small)
NST_hitterdata <- NST_hitterdata %>% mutate(bucket = case_when(
# separate elite players first, put them in their own bucket (top 10-15 in league)
wOBA > high_wOBA ~ "challenge",
# bucket based on red flags (is the player 'bad' at anything)
rng_ec_angle >= 95 | rng_ec_angle <= 85 | rng_ecv > 9 ~ "launch pos lv1",
rng_bat_speed < low_bat_speed & K_pct < low_K_pct & GB. > high_GB_pct ~ "bat speed lv1",
GB. > high_GB_pct | FB. > high_FB_pct ~ "swing decision lv1", # damage percentage? want LA of 14-24 degrees, ~90mph exit velo (can change by league/age)
rng_bat_speed < low_bat_speed & K_pct > high_K_pct ~ "confidence",
rng_bat_speed < low_bat_speed ~ "bat speed lv1", # catch anyone with very low bat speed but not in confidence bucket
# if no red flags present, bucket based on yellow flags (is the player below average at anything?)
rng_ecv > 7 ~ "launch pos lv2",
rng_bat_speed < avg_bat_speed ~ "bat speed lv2",
GB. > LG_avg_GB_pct | FB. > LG_avg_FB_pct ~ "swing decision lv2",
# if no yellow flags present, identify which areas the player isn't 'elite' at
rng_ecv > 5 ~ "launch pos lv3",
rng_bat_speed < high_bat_speed ~ "bat speed lv3",
GB. > low_GB_pct | FB. > low_FB_pct ~ "swing decision lv3",
TRUE ~ "undefined"
))
library(tidyverse)
library(tidyverse)
# load data
NST_hitterdata <- read.csv('North Shore PR Twins Summer 2025 Hitting Stats.csv')
LG_hitterdata <- read.csv('League Hitting Stats.csv')
# add strikeout percentages to all players
NST_hitterdata <- NST_hitterdata %>% mutate(K_pct = SO / AB * 100)
LG_hitterdata <- LG_hitterdata %>% mutate(K_pct = SO / AB * 100)
# PBL 2025 total counting stats for wOBA
LG_BB <- sum(LG_hitterdata$BB)
LG_HBP <- sum(LG_hitterdata$HBP)
LG_singles <- sum(LG_hitterdata$X1B)
LG_doubles <- sum(LG_hitterdata$X2B)
LG_triples <- sum(LG_hitterdata$X3B)
LG_HR <- sum(LG_hitterdata$HR)
LG_AB <- sum(LG_hitterdata$AB)
LG_SF <- sum(LG_hitterdata$SF)
# PBL 2025 factor weights (from GPT-5)
BB_factor <- 0.666
HBP_factor <- 0.697
singles_factor <- 0.840
doubles_factor <- 1.187
triples_factor <- 1.500
HR_factor <- 1.919
# add wOBA to all players
LG_hitterdata <- mutate(LG_hitterdata, wOBA = (BB_factor * BB +
HBP_factor * HBP +
singles_factor * X1B +
doubles_factor * X2B +
triples_factor * X3B +
HR_factor * HR) / (AB + BB + SF + HBP))
# add wOBA to Twins players
NST_hitterdata <- mutate(NST_hitterdata, wOBA = (BB_factor * BB +
HBP_factor * HBP +
singles_factor * X1B +
doubles_factor * X2B +
triples_factor * X3B +
HR_factor * HR) / (AB + BB + SF + HBP))
# average wOBA in PBL
LG_avg_wOBA <- (BB_factor * LG_BB +
HBP_factor * LG_HBP +
singles_factor * LG_singles +
doubles_factor * LG_doubles +
triples_factor * LG_triples +
HR_factor * LG_HR) / (LG_AB + LG_BB + LG_SF + LG_HBP)
# standard deviation of wOBA in PBL
LG_sd_wOBA <- sd(LG_hitterdata$wOBA) # 0.062
# average strikeout percentage in PBL
LG_avg_K_pct <- mean(LG_hitterdata$K_pct) # 22.52%
# standard deviation of K% in PBL
LG_sd_K_pct <- sd(LG_hitterdata$K_pct) # 8.98%
# average line drive, ground ball, fly ball percentage in PBL
LG_avg_LD_pct <- mean(LG_hitterdata$LD.) # 17.70%
LG_avg_GB_pct <- mean(LG_hitterdata$GB.) # 43.26%
LG_avg_FB_pct <- mean(LG_hitterdata$FB.) # 35.09%
# standard deviation of LD, GB, FB% in PBL
LG_sd_LD_pct <- sd(LG_hitterdata$LD.) # 6.08%
LG_sd_GB_pct <- sd(LG_hitterdata$GB.) # 8.05%
LG_sd_FB_pct <- sd(LG_hitterdata$FB.) # 7.95%
# benchmark for a high wOBA
high_wOBA <- LG_avg_wOBA + 1.5*LG_sd_wOBA # >0.412
# benchmark for a high/low K%
high_K_pct <- LG_avg_K_pct + 0.75*LG_sd_K_pct # >29.25%   MAYBE GO LOWER? 0.5 SD would be a 27% K rate
low_K_pct <- LG_avg_K_pct - 0.75*LG_sd_K_pct # <15.79%
# benchmark for a high/low line drive, ground ball, and fly ball percentage
# may tweak based on Zach's thoughts
high_LD_pct <- LG_avg_LD_pct + 0.75*LG_sd_LD_pct # >22.26%
low_LD_pct <- LG_avg_LD_pct - 0.75*LG_sd_LD_pct # <13.14%
high_GB_pct <- LG_avg_GB_pct + 0.75*LG_sd_GB_pct # >49.30%
low_GB_pct <- LG_avg_GB_pct - 0.75*LG_sd_GB_pct # <37.23%
high_FB_pct <- LG_avg_FB_pct + 0.75*LG_sd_FB_pct # >41.05%
low_FB_pct <- LG_avg_FB_pct - 0.75*LG_sd_FB_pct # <29.12%
set.seed(3)
blast_data <- read.csv("blast_data_sample.csv")
blast_data <- blast_data[1:368, ]
avg_bat_speed <- mean(blast_data$Bat.Speed..mph.)
avg_bat_speed # 60.88
sd_bat_speed <- sd(blast_data$Bat.Speed..mph.)
sd_bat_speed # 4.17
# create randomly generated bat speeds, assign them to Twins players
random_bat_speeds <- rnorm(17, mean = avg_bat_speed, sd = sd_bat_speed)
NST_hitterdata <- NST_hitterdata %>% mutate(rng_bat_speed = random_bat_speeds)
blast_data_filtered <- select(blast_data, c('Player.Name', 'Bat.Speed..mph.', 'Early.Connection..deg.'))
blast_data_player <- blast_data_filtered %>% group_by(Player.Name) %>%
summarise(mean_bat_speed = mean(Bat.Speed..mph.),
early_con_var = sd(Early.Connection..deg.)*2,
early_con_mean = mean(Early.Connection..deg.))
mean_ecv_estimate <- mean(blast_data_player$early_con_var)
sd_ecv_estimate <- sd(blast_data_player$early_con_var)
high_bat_speed <- avg_bat_speed + 0.75*sd_bat_speed # 64.01
low_bat_speed <- avg_bat_speed - 0.75*sd_bat_speed # 57.76
# create randomly generated bat speeds, assign them to Twins players
random_ecv <- rnorm(17, mean = 8, sd = 0.5*sd_ecv_estimate)
random_ec_angle <- rnorm(17, mean = 90, sd = 0.25*sd(blast_data_filtered$Early.Connection..deg.))
NST_hitterdata <- NST_hitterdata %>% mutate(rng_ec_angle = random_ec_angle, rng_ecv = random_ecv)
NST_hitterdata <- NST_hitterdata %>% mutate(bucket = case_when(
# separate elite players first, put them in their own bucket (top 10-15 in league)
wOBA > high_wOBA ~ "challenge",
# bucket based on red flags (is the player 'bad' at anything)
rng_ec_angle >= 95 | rng_ec_angle <= 85 | rng_ecv > 9 ~ "launch pos lv1",
rng_bat_speed < low_bat_speed & K_pct < low_K_pct & GB. > high_GB_pct ~ "bat speed lv1",
GB. > high_GB_pct | FB. > high_FB_pct ~ "swing decision lv1", # damage percentage? want LA of 14-24 degrees, ~90mph exit velo (can change by league/age)
rng_bat_speed < low_bat_speed & K_pct > high_K_pct ~ "confidence",
rng_bat_speed < low_bat_speed ~ "bat speed lv1", # catch anyone with very low bat speed but not in confidence bucket
# if no red flags present, bucket based on yellow flags (is the player below average at anything?)
rng_ecv > 7 ~ "launch pos lv2",
rng_bat_speed < avg_bat_speed ~ "bat speed lv2",
GB. > LG_avg_GB_pct | FB. > LG_avg_FB_pct ~ "swing decision lv2",
# if no yellow flags present, identify which areas the player isn't 'elite' at
rng_ecv > 5 ~ "launch pos lv3",
rng_bat_speed < high_bat_speed ~ "bat speed lv3",
GB. > low_GB_pct | FB. > low_FB_pct ~ "swing decision lv3",
TRUE ~ "undefined"
))
NST_hitterdata_small <- NST_hitterdata %>% select(Last, First, LD., FB., GB., K_pct, wOBA, rng_bat_speed, rng_ec_angle, rng_ecv, bucket)
view(NST_hitterdata_small)
